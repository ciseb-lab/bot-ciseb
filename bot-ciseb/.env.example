# Server-only secrets and deployment settings.
GEMINI_API_KEY=
NODE_ENV=development
PORT=3000
APP_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HOPS=0
API_JSON_LIMIT=200kb
FIREBASE_PROJECT_ID=
# For local Firebase Emulator Suite only; leave unset for a real project.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
APP_CHECK_REQUIRED=false

# Initial per-user and per-IP limits; tune centrally after observing production usage.
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=100
API_RATE_LIMIT_PER_IP_PER_MINUTE=30
PDF_RATE_LIMIT_PER_MINUTE=5
PDF_RATE_LIMIT_PER_IP_PER_MINUTE=10
CHAT_MAX_INPUT_CHARS=4000
CHAT_HISTORY_MAX_CHARS=1200
CHAT_MAX_CONCURRENCY_PER_USER=2
GEMINI_TIMEOUT_MS=45000

# Firebase Web SDK settings (public client configuration, not Admin credentials).
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_ENABLED=false
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_USE_FIREBASE_EMULATORS=false
VITE_ALLOW_INSTITUTIONAL_SIGNUP=false
