rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasInstitutionalIdentity(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^[^@]+@escola[.]seduc[.]pa[.]gov[.]br$');
    }

    function validGroundedDocument(reference) {
      return reference is map
        && reference.keys().hasOnly(['source', 'title', 'pageNumber'])
        && reference.keys().hasAll(['source', 'title'])
        && reference.source is string
        && reference.source.size() > 0
        && reference.source.size() <= 180
        && reference.title is string
        && reference.title.size() > 0
        && reference.title.size() <= 180
        && (!('pageNumber' in reference) || (reference.pageNumber is int && reference.pageNumber > 0));
    }

    function validGroundedDocuments(references) {
      return references is list
        && references.size() <= 5
        && (references.size() < 1 || validGroundedDocument(references[0]))
        && (references.size() < 2 || validGroundedDocument(references[1]))
        && (references.size() < 3 || validGroundedDocument(references[2]))
        && (references.size() < 4 || validGroundedDocument(references[3]))
        && (references.size() < 5 || validGroundedDocument(references[4]));
    }

    match /users/{userId} {
      allow get: if hasInstitutionalIdentity(userId);
      allow list, delete: if false;
      allow create: if hasInstitutionalIdentity(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasInstitutionalIdentity(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/conversations/{conversationId} {
      allow get, list, delete: if hasInstitutionalIdentity(userId);
      allow create: if hasInstitutionalIdentity(userId)
        && request.resource.data.keys().hasOnly(['title', 'schemaVersion', 'messageCount', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.schemaVersion == 1
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 1
        && request.resource.data.messageCount <= 10000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if hasInstitutionalIdentity(userId)
        && request.resource.data.keys().hasOnly(['title', 'schemaVersion', 'messageCount', 'createdAt', 'updatedAt'])
        && request.resource.data.title == resource.data.title
        && request.resource.data.schemaVersion == 1
        && request.resource.data.messageCount == resource.data.messageCount + 1
        && request.resource.data.messageCount <= 10000
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      match /messages/{messageId} {
        allow read, delete: if hasInstitutionalIdentity(userId);
        allow create: if hasInstitutionalIdentity(userId)
          && request.resource.data.keys().hasOnly(['role', 'content', 'sequence', 'createdAt', 'groundedDocuments'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 12000
          && request.resource.data.sequence is int
          && request.resource.data.sequence >= 0
          && request.resource.data.sequence < 10000
          && request.resource.data.createdAt == request.time
          && validGroundedDocuments(request.resource.data.groundedDocuments)
          && getAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)).data.messageCount > request.resource.data.sequence;
        allow update: if false;
      }
    }

    match /rateLimitCounters/{counterId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
